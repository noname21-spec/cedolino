{
  "id": "./",
  "name": "Cedolino – buste paga",
  "short_name": "Cedolino",
  "description": "Stima il netto della busta paga dai turni, controlla ogni voce con le regole fiscali 2026 e tiene in ordine ferie, contratti e documenti. Gratis, senza pubblicità; i dati restano sul telefono.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./?app=pwa#home",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "finance",
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Carica una busta paga",
      "short_name": "Carica busta",
      "url": "./?app=pwa#azione-busta",
      "icons": [
        {
          "src": "icons/sc/busta.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Inizio o fine turno",
      "short_name": "Timbra",
      "url": "./?app=pwa#azione-timbra",
      "icons": [
        {
          "src": "icons/sc/turno.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Turni del mese",
      "short_name": "Turni",
      "url": "./?app=pwa#turni",
      "icons": [
        {
          "src": "icons/sc/turni.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calcola il netto",
      "short_name": "Calcola",
      "url": "./?app=pwa#calcola",
      "icons": [
        {
          "src": "icons/sc/calcola.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?app=pwa#condiviso",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "screenshots": [
    {
      "src": "screenshots/home.jpg",
      "sizes": "880x1912",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "La prossima busta stimata dai turni"
    },
    {
      "src": "screenshots/busta.jpg",
      "sizes": "880x1912",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Controllo della busta paga voce per voce"
    },
    {
      "src": "screenshots/stima.jpg",
      "sizes": "880x1912",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Dal lordo al netto, spiegato"
    },
    {
      "src": "screenshots/turni.jpg",
      "sizes": "880x1912",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Turni, timbro, ferie e straordinari"
    },
    {
      "src": "screenshots/sefosse.jpg",
      "sizes": "880x1912",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Simulatore «E se…»"
    },
    {
      "src": "screenshots/lavori.jpg",
      "sizes": "880x1912",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Tutti i tuoi lavori e contratti"
    }
  ],
  "prefer_related_applications": false
}
